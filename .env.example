# Copy this file to ".env" (PowerShell: Copy-Item .env.example .env) and fill in your key.
# NEVER commit or share the real .env file. It is listed in .gitignore.

# Required for AI generation. Create one at https://platform.stability.ai (API keys page).
STABILITY_API_KEY=your_stability_api_key_here

# Default generator when the app starts: "stability" (hosted AI) or "offline" (free, non-AI fallback)
SKETCH2REALITY_PROVIDER=stability

# ---- Optional settings (defaults shown) ----
# Seconds to wait for the API before giving up
REQUEST_TIMEOUT_SECONDS=120
# Sketches are shrunk so the longest side is at most this many pixels (smaller = faster)
MAX_IMAGE_SIDE=1024
# Largest upload accepted, in megabytes
MAX_UPLOAD_MB=10
# Maximum variations per click (each variation is a separate paid generation)
MAX_VARIATIONS=3
# Local web port
SERVER_PORT=7860
# Used only for the on-screen cost estimate. Check https://docs.stability.ai/pricing in case it changes.
STABILITY_CREDITS_PER_IMAGE=5
CREDIT_PRICE_USD=0.01
